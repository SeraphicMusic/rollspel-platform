{
  "notation": "^(\\d+)[Tt](\\d+)([+-]\\d+)?$",
  "sides": [4, 6, 8, 10, 20, 100],
  "misread_to_canonical": {
    "I": ["1", "T"], "l": ["1", "T"], "i": ["1"], "|": ["1", "T"],
    "O": ["0"], "o": ["0"], "Q": ["0"],
    "S": ["5"], "s": ["5"], "B": ["8", "3"], "G": ["6"], "b": ["6"],
    "Z": ["2"], "z": ["2"], "g": ["9"], "q": ["9"], "A": ["4"],
    "7": ["T", "7"], "+": ["T", "+"], "D": ["T"], "d": ["T"], "t": ["T"]
  }
}
